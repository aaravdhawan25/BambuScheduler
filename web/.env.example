# Copy to web/.env.local for local dev; set the same two in Vercel project settings.
# Only the ANON key ever goes in the browser. RLS is the security boundary.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Set to 1 to run with an in-browser demo backend and simulated hub (no Supabase needed).
# The app also falls back to demo mode when the two variables above are missing.
# VITE_DEMO=1
