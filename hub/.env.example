# Copy to hub/.env (never commit .env). Secrets here stay on the hub only.

# Supabase project (Settings -> API). Use the ANON key, never the service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# The hub's device account (Auth -> Users), with role 'hub' in public.members.
HUB_EMAIL=hub@example.com
HUB_PASSWORD=change-me-long-random

# 1 = simulated printer (no hardware needed). 0 = real Bambu A1 on the LAN.
MOCK=1
MOCK_PRINT_SECONDS=120

# Printer (LAN Only Mode + Developer Mode). Only needed when MOCK=0.
PRINTER_IP=192.168.1.50
PRINTER_SERIAL=03919A0000000000
PRINTER_ACCESS_CODE=12345678

# Optional
LOOP_SECONDS=4
WORK_DIR=/tmp/bambu-hub
LOG_LEVEL=INFO
# NTFY_BASE_URL=https://ntfy.sh
